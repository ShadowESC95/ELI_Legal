+ENTRY_POINT_GROUP = "eli.editions"
+
+
+def _discover_installed() -> dict[str, Edition]:
+    """Edition packs installed as their own packages (separate products / paid add-ons).
+
+    A pack advertises itself with an entry point in the ``eli.editions`` group whose value is
+    ``<package>:<register callable>``; its ``manifest.json`` sits beside that module. Only the
+    manifest is read here. Nothing of the pack runs until ``activate_edition`` is called.
+    """
+    out: dict[str, Edition] = {}
+    try:
+        from importlib import metadata
+        from importlib.util import find_spec
+        entries = list(metadata.entry_points(group=ENTRY_POINT_GROUP))
+    except Exception:
+        return out
+    for ep in entries:
+        try:
+            module_name = ep.value.split(":", 1)[0]
+            spec = find_spec(module_name)
+            if spec is None or not spec.origin:
+                continue
+            folder = Path(spec.origin).resolve().parent
+            ed = _load(folder / "manifest.json", pkg=module_name, location=str(folder))
+        except Exception:
+            continue
+        if ed is not None:
+            out[ed.name] = ed
+    return out
+
