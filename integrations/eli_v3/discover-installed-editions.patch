+def activate_edition(name: str, *, host: Any = None,
+                     entitled: set[str] | None = None) -> dict[str, Any] | None:
+    """Activate an installed edition pack by calling its ``register`` entry point.
+
+    Returns what the pack registered, or None if the edition is not entitled, is in-tree
+    (nothing to call), or is not installed. The pack itself refuses when ``entitled`` is given
+    and does not include it, so entitlement is enforced on both sides.
+    """
+    ed = active_editions(entitled).get(str(name).lower().strip()) if entitled is not None \
+        else discover_editions().get(str(name).lower().strip())
+    if ed is None or not ed.external:
+        return None
+    from importlib import metadata
+    for ep in metadata.entry_points(group=ENTRY_POINT_GROUP):
+        if ep.value.split(":", 1)[0] == ed.pkg:
+            return ep.load()(host, entitled=entitled)
+    return None
+
