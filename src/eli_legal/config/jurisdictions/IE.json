    {"id": "ie_reports", "kind": "case", "regex": "\\[(?:18|19|20)\\d{2}\\]\\s+\\d+\\s+(?:I\\.?R\\.?|I\\.?L\\.?R\\.?M\\.?)\\s+\\d+", "example": "[2010] 2 IR 123"},
    {"id": "ie_si", "kind": "legislation", "regex": "S\\.?I\\.?\\s+No\\.?\\s*\\d+\\s+of\\s+(?:19|20)\\d{2}", "example": "S.I. No. 361 of 2010"},
    {"id": "act_title_year", "kind": "legislation", "regex": "@ACT", "example": "Arbitration Act 2010"}
  ],
