{
  "policy_version": "0.4.0",
  "runtime": {
    "network_default": "deny",
    "audit_fail_closed": true,
    "human_release_required": true,
    "human_recipient_confirmation_required": true,
    "matter_isolation_required": true,
    "source_registry_enforced": true,
    "verification_before_reliance": true,
    "source_content_is_data_not_instruction": true,
    "require_validated_jurisdiction_packs": false,
    "require_reviewer_distinct_from_operator": false,
    "model_proposition_verification_validated": false,
    "max_model_chunks": 200,
    "research_passages_per_issue": 4
  },
  "monitoring": {
    "hard_gate_breach_alert": 1,
    "override_rate_alert": 0.10,
    "approval_without_challenge_runs": 20
  },
  "allowed_actions": [
    "matter.create",
    "matter.read",
    "matter.manage",
    "matter.close",
    "document.ingest",
    "document.read",
    "document.waive",
    "source.search_approved",
    "source.retrieve_approved",
    "source.manage",
    "framework.manage",
    "user.manage",
    "config.manage",
    "facts.extract",
    "issues.map",
    "evidence.map",
    "research.run",
    "citation.verify",
    "proposition.verify",
    "authority.status_check",
    "verification.override",
    "report.draft",
    "report.review",
    "report.approve",
    "report.export",
    "report.prepare_release",
    "report.send",
    "workflow.run",
    "workflow.hold",
    "workflow.stop",
    "workflow.restart",
    "hold.resolve",
    "incident.manage",
    "audit.read",
    "audit.verify",
    "evidence.export",
    "compliance.manage",
    "checks.run"
  ],
  "prohibited_actions": [
    "award.issue",
    "final_decision.make",
    "outcome.recommend",
    "party.contact.unapproved",
    "evidence.modify_original",
    "privilege_decide_unapproved",
    "disclosure_decide_unapproved",
    "web.unapproved",
    "tool.unapproved",
    "shell.general",
    "desktop.control",
    "personal_memory",
    "self_modify",
    "proactive_personal_assistant",
    "report.send_without_human_release_approval"
  ],
  "release_gates": {
    "all_material_claims_verified": true,
    "authorities_current_or_explicitly_flagged": true,
    "audit_chain_valid": true,
    "audit_complete_for_run": true,
    "named_reviewer_approval": true,
    "warnings_acknowledged": true,
    "human_recipient_confirmation": true,
    "recipient_matter_authorisation": true,
    "report_hash_matches_approval": true,
    "no_unresolved_hard_gate": true
  }
}
