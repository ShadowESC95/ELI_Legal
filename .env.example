ELI_LEGAL_ENV=development
ELI_LEGAL_MODE=standalone
ELI_LEGAL_DB_PATH=./data/eli_legal.sqlite3
ELI_LEGAL_AUDIT_DB_PATH=./data/audit.sqlite3
ELI_LEGAL_AUDIT_KEY_FILE=./secrets/audit_hmac.key
ELI_LEGAL_DATA_DIR=./data/matters
ELI_LEGAL_ARTIFACTS_DIR=./artifacts
ELI_LEGAL_NETWORK_DEFAULT=deny
ELI_LEGAL_LOG_LEVEL=INFO

# How long a command-line sign-in lasts before the passphrase is needed again.
ELI_LEGAL_SESSION_HOURS=8

# Optional local model. "none" runs every step that does not need one.
ELI_LEGAL_INFERENCE=none
ELI_LEGAL_INFERENCE_URL=http://127.0.0.1:11434/v1
ELI_LEGAL_INFERENCE_MODEL=
# A different model, used only to check reworded propositions. Advisory unless the policy
# records that it has been validated for that use.
ELI_LEGAL_VERIFIER_MODEL=

# Where an installed copy keeps everything. Unset in a source checkout (the working directory).
# ELI_LEGAL_HOME=

# After this many wrong passphrases or codes in a row, the account is locked for a while.
ELI_LEGAL_LOCKOUT_THRESHOLD=5
ELI_LEGAL_LOCKOUT_MINUTES=15

# The server (eli-legal serve). It listens on this machine only unless started with --lan,
# and will not listen beyond it without TLS.
ELI_LEGAL_SERVER_HOST=127.0.0.1
ELI_LEGAL_SERVER_PORT=8443
# ELI_LEGAL_SERVER_TLS_CERT=
# ELI_LEGAL_SERVER_TLS_KEY=
# Extra names the server answers to, comma-separated.
ELI_LEGAL_SERVER_ALLOWED_HOSTS=
ELI_LEGAL_SERVER_SESSION_HOURS=8
ELI_LEGAL_SERVER_IDLE_MINUTES=30
# auto: required whenever the server is reachable from other machines.
ELI_LEGAL_SERVER_REQUIRE_SECOND_FACTOR=auto
ELI_LEGAL_SERVER_MAX_UPLOAD_MB=250
